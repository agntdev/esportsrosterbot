[
  {
    "name": "Регистрация команды собирает заявку и публикует её после подтверждения",
    "steps": [
      { "send": { "callback": "register:start" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Введите название команды." } }] },
      { "send": { "text": "Northwind" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Капитан — Game ID." } }, { "method": "deleteMessage", "payload": { "chat_id": 1, "message_id": 2 } }] },
      { "send": { "text": "n1" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Капитан — игровой никнейм." } }] },
      { "send": { "text": "Nova" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Укажите контакт капитана: @username или номер телефона." } }] },
      { "send": { "text": "@northwind" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Игрок 2 — Game ID." } }] },
      { "send": { "text": "n2" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Игрок 2 — игровой никнейм." } }] },
      { "send": { "text": "Orbit" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Игрок 3 — Game ID." } }] },
      { "send": { "text": "n3" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Игрок 3 — игровой никнейм." } }] },
      { "send": { "text": "Apex" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Игрок 4 — Game ID." } }] },
      { "send": { "text": "n4" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Игрок 4 — игровой никнейм." } }] },
      { "send": { "text": "Vector" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Игрок 5 — Game ID." } }] },
      { "send": { "text": "n5" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Игрок 5 — игровой никнейм." } }] },
      { "send": { "text": "Drift" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Пять основных игроков добавлены. Можно указать до двух замен." } }] },
      { "send": { "callback": "register:preview" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Проверьте заявку:\n\n🏆 Команда #1 — Northwind\nКапитан: Nova\nКонтакт капитана: @northwind\nСостав:\nКапитан: n1 — Nova\nИгрок 2: n2 — Orbit\nИгрок 3: n3 — Apex\nИгрок 4: n4 — Vector\nИгрок 5: n5 — Drift\nЗамены: нет" } }] },
      { "send": { "callback": "register:edit" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Выберите поле для изменения." } }] },
      { "send": { "callback": "register:edit:player:1" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Игрок 2 — Game ID. Текущее: n2." } }] },
      { "send": { "text": "n22" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Игрок 2 — игровой никнейм. Текущее: Orbit." } }] },
      { "send": { "text": "Orbit2" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Проверьте заявку:\n\n🏆 Команда #1 — Northwind\nКапитан: Nova\nКонтакт капитана: @northwind\nСостав:\nКапитан: n1 — Nova\nИгрок 2: n22 — Orbit2\nИгрок 3: n3 — Apex\nИгрок 4: n4 — Vector\nИгрок 5: n5 — Drift\nЗамены: нет" } }] },
      { "send": { "callback": "register:edit" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Выберите поле для изменения." } }] },
      { "send": { "callback": "register:edit:captain" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Капитан — Game ID. Текущее: n1." } }] },
      { "send": { "text": "n10" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Капитан — игровой никнейм. Текущее: Nova." } }] },
      { "send": { "text": "Nova10" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Укажите контакт капитана. Текущий: @northwind." } }] },
      { "send": { "text": "@northwind10" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Проверьте заявку:\n\n🏆 Команда #1 — Northwind\nКапитан: Nova10\nКонтакт капитана: @northwind10\nСостав:\nКапитан: n10 — Nova10\nИгрок 2: n22 — Orbit2\nИгрок 3: n3 — Apex\nИгрок 4: n4 — Vector\nИгрок 5: n5 — Drift\nЗамены: нет" } }] },
      { "send": { "callback": "register:confirm" }, "expect": [{ "method": "sendMessage", "payload": { "text": "🏆 Команда #1 — Northwind\nКапитан: Nova10\nКоманда опубликована в списке команд. Уведомление организатору пока не настроено." } }] },
      { "send": { "callback": "teams:show" }, "expect": [{ "method": "editMessageText", "payload": { "text": "Команды\n\nNorthwind\nCaptain ID: 1" } }] },
      { "send": { "callback": "edit:team" }, "expect": [{ "method": "sendMessage", "payload": { "text": "🏆 Команда #1 — Northwind\n\nID команды #1 не изменяется. Подтвердите ID, чтобы перейти к названию." } }] },
      { "send": { "callback": "edit:team:id:confirm" }, "expect": [{ "method": "sendMessage", "payload": { "text": "ID команды #1 подтверждён. Введите название команды. Текущее: Northwind." } }] },
      { "send": { "text": "Northwind" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Команда обновлена: 🏆 Команда #1 — Northwind." } }] },
      { "send": { "callback": "edit:roster" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Выберите игрока для изменения в команде 🏆 Команда #1 — Northwind." } }] },
      { "send": { "callback": "edit:clear:0" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Слот игрока 1 очищен. Добавьте игрока, чтобы заявка снова стала полной." } }] },
      { "send": { "callback": "edit:slot:0" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Введите Game ID и никнейм для игрока 1 через |." } }] },
      { "send": { "text": "n111 | Nova11" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Состав команды 🏆 Команда #1 — Northwind обновлён." } }] },
      { "send": { "callback": "register:start" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Введите название команды." } }] },
      { "send": { "text": "northwind" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Похожий никнейм уже зарегистрирован в этом турнире — выберите другой ник или свяжитесь с администратором." } }] },
      { "send": { "callback": "name:review" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Запрос на проверку отправлен организатору. После решения введите ник ещё раз." } }] },
      { "send": { "callback": "register:name:change" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Введите другое название команды." } }] },
      { "send": { "text": "Northwind Academy" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Капитан — Game ID." } }] },
      { "send": { "callback": "register:start" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Введите название команды." } }] },
      { "send": { "text": "NORTHWIND" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Похожий никнейм уже зарегистрирован в этом турнире — выберите другой ник или свяжитесь с администратором." } }] },
      { "send": { "callback": "register:name:change" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Введите другое название команды." } }] },
      { "send": { "text": "Vanguard" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Капитан — Game ID." } }] }
    ]
  }
]
