[
  {
    "name": "/start replies with the welcome + main menu",
    "steps": [
      {
        "send": { "text": "/start" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Выберите действие для участия в турнире." }
          }
        ]
      }
    ]
  }
  ,
  {
    "name": "/menu восстанавливает главное меню",
    "steps": [
      { "send": { "text": "/menu" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Выберите действие для участия в турнире." } }, { "method": "sendMessage", "payload": { "text": "Главное меню всегда доступно с клавиатуры ниже.", "reply_markup": { "keyboard": [[{ "text": "Главное меню" }]] } } }] },
      { "send": { "text": "Главное меню" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Выберите действие для участия в турнире." } }] }
    ]
  }
]
